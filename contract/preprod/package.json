    "@midnight-ntwrk/wallet-sdk-hd": "3.1.0-rc.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "4.0.0-rc.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "4.0.0-rc.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.5",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.0",
    "ws": "^8.18.0"
  }
